{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aprl.invalid/schemas/job-v1.json",
  "title": "APRL Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "job_id", "generation", "snapshot", "attempt", "operation_id", "correlation_id", "operation"],
  "properties": {
    "version": { "const": 1 },
    "task_id": { "$ref": "#/$defs/uuid" },
    "job_id": { "$ref": "#/$defs/uuid" },
    "generation": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "lease_token": { "$ref": "#/$defs/uuid" },
    "run_id": { "$ref": "#/$defs/uuid" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "operation_id": { "$ref": "#/$defs/uuid" },
    "correlation_id": { "$ref": "#/$defs/uuid" },
    "operation": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "budget_envelope": { "$ref": "#/$defs/budgetEnvelope" }
  },
  "allOf": [
    { "if": { "required": ["lease_token"] }, "then": { "required": ["run_id"] } },
    { "if": { "required": ["run_id"] }, "then": { "required": ["lease_token"] } }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_sha": { "$ref": "#/$defs/sha" },
        "base_sha": { "$ref": "#/$defs/sha" },
        "integration_sha": { "$ref": "#/$defs/sha" }
      },
      "allOf": [
        { "if": { "required": ["head_sha"] }, "then": { "required": ["base_sha"] } },
        { "if": { "required": ["base_sha"] }, "then": { "required": ["head_sha"] } },
        { "if": { "required": ["integration_sha"] }, "then": { "required": ["head_sha", "base_sha"] } }
      ]
    },
    "budgetEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cost_micro_usd", "max_input_tokens", "max_output_tokens", "max_calls", "pricing_version"],
      "properties": {
        "max_cost_micro_usd": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_calls": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "pricing_version": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
